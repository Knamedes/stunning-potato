local function isValidEnemy(obj)
    if not obj or not obj:IsA("Model") or obj == character then return false end
    local hum = obj:FindFirstChild("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    if Players:GetPlayerFromCharacter(obj) then return false end
    local n = obj.Name:lower()
    if n:find("core") or n:find("gate") or n:find("hero") or n:find("friendly") then return false end
    if obj:FindFirstChild("Friendly") or obj:FindFirstChild("Hero") then return false end
    return true
end

local function startKillAura()
    if auraConnection then auraConnection:Disconnect() end
    auraConnection = RunService.Heartbeat:Connect(function()
        if not killAuraEnabled or not root or not guiAlive then return end
        for _, obj in ipairs(workspace:GetChildren()) do
            if isValidEnemy(obj) then
                local hrp = obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Torso")
                if hrp and (root.Position - hrp.Position).Magnitude <= killRange then
                    local hum = obj:FindFirstChild("Humanoid")
                    local now = tick()
                    if not lastDamage[obj] or (now - lastDamage[obj]) >= damageCooldown then
                        hum:TakeDamage(damagePerTick)
                        lastDamage[obj] = now
                    end
                end
            end
        end
    end)
end

toggleBtn.MouseButton1Click:Connect(function()
    if not guiAlive then return end
    killAuraEnabled = not killAuraEnabled
    if killAuraEnabled then
        toggleBtn.Text = "Kill Aura: ON"
        toggleBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 0)
        startKillAura()
    else
        toggleBtn.Text = "Kill Aura: OFF"
        toggleBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
        if auraConnection then auraConnection:Disconnect() auraConnection = nil end
        lastDamage = {}
    end
end)

