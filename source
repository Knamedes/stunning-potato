-- Stealth MTC ESP v2 - 2D Drawing + optional tiny GUI toggles
-- Team colors via plr.TeamColor (prevents friendly fire stupidity)

game.StarterGui:SetCore("SendNotification", {
    Title = "Stealth MTC ESP v2",
    Text = "RightShift / Button = Player ESP\nLeftShift / Button = Vehicle ESP\nUses TeamColor - enemies only look different",
    Duration = 8
})

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Camera = workspace.CurrentCamera
local LocalPlayer = Players.LocalPlayer

getgenv().PlayerESP = true
getgenv().VehicleESP = true
getgenv().ShowOnlyEnemies = true  -- NEW: hide teammates if true

local useMinimalGUI = true  -- set false to remove buttons completely (pure hotkeys)

local playerDrawings = {}
local vehicleDrawings = {}

local function getDistance(pos1, pos2)
    return math.floor((pos1 - pos2).Magnitude)
end

local function isEnemy(plr)
    if not getgenv().ShowOnlyEnemies then return true end
    if not LocalPlayer.Team then return true end
    return plr.Team ~= LocalPlayer.Team
end

-- Minimal GUI (two tiny buttons)
local gui, playerBtn, vehicleBtn
if useMinimalGUI then
    gui = Instance.new("ScreenGui")
    gui.Name = "ESPControls"  -- keep name generic
    gui.ResetOnSpawn = false
    gui.Parent = LocalPlayer:WaitForChild("PlayerGui")

    local frame = Instance.new("Frame", gui)
    frame.Size = UDim2.new(0, 120, 0, 60)
    frame.Position = UDim2.new(0, 10, 0, 10)
    frame.BackgroundTransparency = 0.6
    frame.BackgroundColor3 = Color3.new(0,0,0)

    playerBtn = Instance.new("TextButton", frame)
    playerBtn.Size = UDim2.new(1,0,0.5,0)
    playerBtn.Position = UDim2.new(0,0,0,0)
    playerBtn.Text = "Player ESP: ON"
    playerBtn.BackgroundColor3 = Color3.fromRGB(40,40,40)
    playerBtn.TextColor3 = Color3.new(1,1,1)

    vehicleBtn = Instance.new("TextButton", frame)
    vehicleBtn.Size = UDim2.new(1,0,0.5,0)
    vehicleBtn.Position = UDim2.new(0,0,0.5,0)
    vehicleBtn.Text = "Vehicle ESP: ON"
    vehicleBtn.BackgroundColor3 = Color3.fromRGB(40,40,40)
    vehicleBtn.TextColor3 = Color3.new(1,1,1)

    playerBtn.MouseButton1Click:Connect(function()
        getgenv().PlayerESP = not getgenv().PlayerESP
        playerBtn.Text = "Player ESP: " .. (getgenv().PlayerESP and "ON" or "OFF")
    end)

    vehicleBtn.MouseButton1Click:Connect(function()
        getgenv().VehicleESP = not getgenv().VehicleESP
        vehicleBtn.Text = "Vehicle ESP: " .. (getgenv().VehicleESP and "ON" or "OFF")
    end)
end

-- Hotkeys still work
UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if input.KeyCode == Enum.KeyCode.RightShift then
        getgenv().PlayerESP = not getgenv().PlayerESP
        game.StarterGui:SetCore("SendNotification", {Title = "Player ESP", Text = getgenv().PlayerESP and "ON" or "OFF"})
        if playerBtn then playerBtn.Text = "Player ESP: " .. (getgenv().PlayerESP and "ON" or "OFF") end
    elseif input.KeyCode == Enum.KeyCode.LeftShift then
        getgenv().VehicleESP = not getgenv().VehicleESP
        game.StarterGui:SetCore("SendNotification", {Title = "Vehicle ESP", Text = getgenv().VehicleESP and "ON" or "OFF"})
        if vehicleBtn then vehicleBtn.Text = "Vehicle ESP: " .. (getgenv().VehicleESP and "ON" or "OFF") end
    end
end)

-- Cleanup functions (same as before)
local function cleanupPlayer(plr)
    if playerDrawings[plr] then
        for _, obj in pairs(playerDrawings[plr]) do obj:Remove() end
        playerDrawings[plr] = nil
    end
end

local function cleanupVehicle(veh)
    if vehicleDrawings[veh] then
        for _, obj in pairs(vehicleDrawings[veh]) do obj:Remove() end
        vehicleDrawings[veh] = nil
    end
end
Players.PlayerRemoving:Connect(cleanupPlayer)

RunService.RenderStepped:Connect(function()
    local myPos = (LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") and LocalPlayer.Character.HumanoidRootPart.Position) or Vector3.new()

    -- PLAYER ESP
    if getgenv().PlayerESP then
        for _, plr in pairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") and plr.Character:FindFirstChild("Head") and isEnemy(plr) then
                local hrp = plr.Character.HumanoidRootPart
                local head = plr.Character.Head
                local rootPos, _ = Camera:WorldToViewportPoint(hrp.Position)
                local headPos, _ = Camera:WorldToViewportPoint(head.Position)

                if rootPos.Z > 0 then
                    local dist = getDistance(myPos, hrp.Position)

                    if not playerDrawings[plr] then
                        playerDrawings[plr] = {
                            Box = Drawing.new("Square"),
                            Name = Drawing.new("Text"),
                            Distance = Drawing.new("Text")
                        }
                        local d = playerDrawings[plr]
                        d.Box.Thickness = 2
                        d.Box.Filled = false
                        d.Box.Transparency = 1
                        d.Name.Size = 14
                        d.Name.Center = true
                        d.Name.Outline = true
                        d.Name.Font = 2  -- UI
                        d.Distance.Size = 12
                        d.Distance.Center = true
                        d.Distance.Outline = true
                        d.Distance.Font = 2
                    end

                    local d = playerDrawings[plr]
                    local boxHeight = math.abs(headPos.Y - rootPos.Y) * 1.8
                    d.Box.Size = Vector2.new(boxHeight * 0.55, boxHeight)
                    d.Box.Position = Vector2.new(rootPos.X - boxHeight * 0.275, rootPos.Y - boxHeight * 0.5)
                    d.Box.Color = plr.TeamColor.Color  -- team color!
                    d.Box.Visible = true

                    d.Name.Text = plr.Name
                    d.Name.Color = plr.TeamColor.Color
                    d.Name.Position = Vector2.new(rootPos.X, rootPos.Y - boxHeight * 0.5 - 18)
                    d.Name.Visible = true

                    d.Distance.Text = dist .. "m"
                    d.Distance.Color = Color3.new(1,1,1)
                    d.Distance.Position = Vector2.new(rootPos.X, rootPos.Y + boxHeight * 0.5 + 5)
                    d.Distance.Visible = true
                else
                    if playerDrawings[plr] then for _,obj in pairs(playerDrawings[plr]) do obj.Visible = false end end
                end
            else
                cleanupPlayer(plr)
            end
        end
    else
        for _,data in pairs(playerDrawings) do for _,obj in pairs(data) do obj.Visible = false end end
    end

    -- VEHICLE ESP (same as before, but can add team check later if vehicles expose Team)
    if getgenv().VehicleESP then
        local spawned = workspace:FindFirstChild("SpawnedVehicles")
        if spawned then
            for veh,_ in pairs(vehicleDrawings) do
                if not veh.Parent or veh.Parent ~= spawned then cleanupVehicle(veh) end
            end

            for _, veh in pairs(spawned:GetChildren()) do
                if veh:IsA("Model") then
                    local pivot = veh:GetPivot().Position
                    local screen, onScreen = Camera:WorldToViewportPoint(pivot + Vector3.new(0,8,0))

                    if onScreen and screen.Z > 0 then
                        local dist = getDistance(myPos, pivot)
                        -- could try to detect team color from a part if exists, but name works ok
                        local color = Color3.fromRGB(255,0,0)  -- default enemy red; adjust per faction if needed

                        if not vehicleDrawings[veh] then
                            vehicleDrawings[veh] = {
                                Name = Drawing.new("Text"),
                                Distance = Drawing.new("Text")
                            }
                            local d = vehicleDrawings[veh]
                            d.Name.Size = 14; d.Name.Center=true; d.Name.Outline=true; d.Name.Font=2
                            d.Distance.Size=12; d.Distance.Center=true; d.Distance.Outline=true; d.Distance.Font=2
                        end

                        local d = vehicleDrawings[veh]
                        d.Name.Text = veh.Name
                        d.Name.Color = color
                        d.Name.Position = Vector2.new(screen.X, screen.Y - 25)
                        d.Name.Visible = true

                        d.Distance.Text = dist .. "m"
                        d.Distance.Color = Color3.new(1,1,1)
                        d.Distance.Position = Vector2.new(screen.X, screen.Y + 5)
                        d.Distance.Visible = true
                    else
                        if vehicleDrawings[veh] then for _,obj in pairs(vehicleDrawings[veh]) do obj.Visible = false end end
                    end
                end
            end
        end
    else
        for _,data in pairs(vehicleDrawings) do for _,obj in pairs(data) do obj.Visible = false end end
    end
end)
