    local amt = tonumber(amountBox.Text) or 10000
    print("→ Giving " .. amt .. " COINS to " .. target.Name)

    -- 1. Leaderstats backup
    pcall(function()
        if target:FindFirstChild("leaderstats") then
            local stat = target.leaderstats:FindFirstChild("Coins") or target.leaderstats:FindFirstChild("Coin") or target.leaderstats:FindFirstChild("Cash")
            if stat then stat.Value += amt end
        end
    end)

    -- 2. Fire ALL possible remotes (this fixes the ghost issue)
    pcall(function()
        for _, v in ipairs(ReplicatedStorage:GetDescendants()) do
            if v:IsA("RemoteEvent") then
                v:FireServer(target, amt)
                v:FireServer(amt)
                v:FireServer("AddCoins", amt)
            end
        end
    end)
    print("Fired all possible coin remotes - check if it registers now")
end)

